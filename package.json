{
  "name": "marketcaster",
  "version": "0.1.0",
  "private": true,
  "license": "ISC",
  "description": "Prediction Arena-style trading agent for Polymarket US and Kalshi",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:overrides": "node scripts/check-runtime-overrides.mjs",
    "cycle": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "experiment:market-selection": "node dist/src/experiments/market-selection.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "p-limit": "6.2.0",
    "pino": "9.14.0",
    "polymarket-us": "0.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
